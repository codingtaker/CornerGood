# Copy to .env and change the password. Never commit .env.

# Database container (docker-compose.yml)
POSTGRES_USER=cornergood
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cornergood
# Host port for the database. Change it (e.g. 5433) if a local PostgreSQL
# already uses 5432, and use the same port in DATABASE_URL below.
DB_PORT=5432

# API (apps/api). The API connects with the least-privilege role cornergood_app
# (README, "Database roles"); choose its password (16 characters or more), then
# run npm run db:migrate and npm run db:app-role.
DATABASE_URL=postgres://cornergood_app:change-me-too-16-chars@localhost:5432/cornergood
# Owner of the database (POSTGRES_USER above): migrations and seed only.
DATABASE_OWNER_URL=postgres://cornergood:change-me@localhost:5432/cornergood
API_PORT=3001
# Origin allowed to call the API with cookies (the web app).
WEB_ORIGIN=http://localhost:3000
# Proxies allowed to give the visitor's address, used by the sign-in limits
# (README, "Accounts and sessions"). In production: every proxy in front of
# the API, e.g. "loopback, 10.0.0.0/8". Never "true".
TRUST_PROXY=loopback

# First administrator, for `npm run admin:create` only (ADR-047). The password
# is typed at the prompt: never put it in this file.
# ADMIN_FULL_NAME=
# ADMIN_PHONE=+228...
# ADMIN_EMAIL=
