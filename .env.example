# Copy to .env and change the password. Never commit .env.

# Database container (docker-compose.yml)
POSTGRES_USER=cornergood
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cornergood
# Host port for the database. Change it (e.g. 5433) if a local PostgreSQL
# already uses 5432, and use the same port in DATABASE_URL below.
DB_PORT=5432

# API (apps/api)
DATABASE_URL=postgres://cornergood:change-me@localhost:5432/cornergood
API_PORT=3001
# Origin allowed to call the API with cookies (the web app).
WEB_ORIGIN=http://localhost:3000
