# Copy to .env.local. Next.js only reads env files from its own folder.
# Address of the API seen from the web server. Browsers never use it: they
# call /api/v1 on the web app, which forwards to this address (next.config.ts).
API_URL=http://localhost:3001/api/v1
# Background map, optional (ADR-030). Read at build time; https, fixed host.
# NEXT_PUBLIC_MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
